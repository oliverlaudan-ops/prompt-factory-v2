# =============================================================================
# Prompt Factory v2 — Environment Variables
# Copy this file to .env and fill in the values below.
#   cp .env.example .env
#
# Required for any deployment: NEXTAUTH_SECRET, ENCRYPTION_KEY, DATABASE_URL.
# Required for Docker Compose: also set DB_PASSWORD in your shell or a
# docker-compose override — see README §"Docker Setup".
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
# Connection string used by the Next.js app.
# Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
#
# LOCAL DEV (outside Docker):
#   postgresql://postgres:postgres@localhost:5432/promptfactory?schema=public
#
# INSIDE DOCKER (default docker-compose.yml):
#   postgresql://postgres:${DB_PASSWORD}@db:5432/promptfactory?schema=public
#
# The <db> name MUST match POSTGRES_DB in docker-compose.yml (default: "promptfactory").
# Avoid special URL characters in the password (/, ?, #, etc.) — they break
# the DSN parser. Generate with:  openssl rand -hex 16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/promptfactory?schema=public"

# -----------------------------------------------------------------------------
# NextAuth v5
# -----------------------------------------------------------------------------
# Used to sign JWTs. Generate with:  openssl rand -base64 48
# MUST be at least 32 characters; do not re-use across deployments.
NEXTAUTH_SECRET="your-secret-key-here"

# Canonical URL of the app (no trailing slash). Used for callback URLs and
# cookie domain.
#   Local dev:  http://localhost:3000
#   Production: https://prompts.example.com
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Node / Next.js
# -----------------------------------------------------------------------------
# "production" for prod, "development" for `next dev`. Affects Secure cookies
# and the signup-route Origin check (see src/app/api/auth/signup/route.ts).
NODE_ENV="production"

# Host the Next.js server binds to. MUST be 0.0.0.0 inside Docker so the
# Nginx reverse-proxy (or another container) can reach it. 127.0.0.1
# would bind to the container loopback only.
HOST="0.0.0.0"

# -----------------------------------------------------------------------------
# AI Prompt-Refinement (Ollama Cloud)
# -----------------------------------------------------------------------------
# 32 bytes, base64-encoded — used to encrypt per-user Ollama API keys at rest
# with AES-256-GCM. Generate with:  openssl rand -base64 32
#
# The cleartext key is NEVER persisted; only the encrypted ciphertext, IV,
# and auth tag are stored in the UserOllamaConfig table.
#
# If this is missing or wrong-length, all /api/settings/ollama and
# /api/prompts/refine requests will return 500 "Server ist nicht korrekt
# konfiguriert: ENCRYPTION_KEY fehlt."
ENCRYPTION_KEY=""
